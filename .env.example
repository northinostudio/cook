MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?appName=Cluster0
JWT_SECRET=replace-with-a-long-random-string
PORT=4000
CLIENT_ORIGIN=http://localhost:5183

# Google Sign-In (optional — the button just doesn't render if unset).
# Same Client ID value in both; VITE_GOOGLE_CLIENT_ID is what the frontend
# bundle needs (Vite only exposes VITE_-prefixed vars to client code),
# GOOGLE_CLIENT_ID is what the backend uses to verify tokens.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
